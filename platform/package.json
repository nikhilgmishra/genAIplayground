{
  "name": "@vsp/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trusted tool gateway, policy, identity binding, action ledger, audit and workflow control plane",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "start:local": "tsx src/main/local.ts",
    "demo": "tsx src/demo/run-demo.ts",
    "evidence": "tsx src/evaluation/cli.ts",
    "schemas:gen": "tsx src/protocol/generate-schemas.ts",
    "asl:gen": "tsx src/workflows/generate-asl.ts",
    "asl:check": "tsx src/workflows/generate-asl.ts --check",
    "schemas:check": "tsx src/protocol/generate-schemas.ts --check",
    "catalog:gen": "tsx src/gateway/generate-catalog.ts",
    "catalog:check": "tsx src/gateway/generate-catalog.ts --check",
    "openapi:gen": "tsx src/gateway/generate-openapi.ts",
    "openapi:check": "tsx src/gateway/generate-openapi.ts --check",
    "contracts:gen": "tsx src/business/contracts/cli-generate-doc.ts",
    "contracts:check": "tsx src/business/contracts/cli-generate-doc.ts --check",
    "scenarios:gen": "tsx src/evaluation/generate.ts && tsx src/evaluation/generate-risk.ts",
    "scenarios:check": "tsx src/evaluation/generate.ts --check && tsx src/evaluation/generate-risk.ts --check",
    "start:worker": "tsx src/worker/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1152.0",
    "@aws-sdk/client-kms": "3.1152.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/client-secrets-manager": "3.1152.0",
    "@aws-sdk/client-sfn": "3.1152.0",
    "@aws-sdk/client-sqs": "3.1152.0",
    "@aws-sdk/lib-dynamodb": "3.1152.0",
    "@electric-sql/pglite": "0.3.15",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@open-policy-agent/opa-wasm": "1.10.0",
    "@opentelemetry/api": "1.9.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.12",
    "asl-validator": "4.0.0",
    "autocannon": "8.0.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
