{
  "realm": "vsp-workforce",
  "displayName": "SYNTHETIC workforce IdP (local)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "roles": {
    "client": {
      "vsp-console": [
        {
          "name": "support-agent",
          "description": "SYNTHETIC console staff role (granted through the /vsp/support-agent group)"
        },
        {
          "name": "supervisor",
          "description": "SYNTHETIC console staff role (granted through the /vsp/supervisor group)"
        },
        {
          "name": "safety-responder",
          "description": "SYNTHETIC console staff role (granted through the /vsp/safety-responder group)"
        },
        {
          "name": "auditor",
          "description": "SYNTHETIC console staff role (granted through the /vsp/auditor group)"
        },
        {
          "name": "knowledge-editor",
          "description": "SYNTHETIC console staff role (granted through the /vsp/knowledge-editor group)"
        },
        {
          "name": "policy-approver",
          "description": "SYNTHETIC console staff role (granted through the /vsp/policy-approver group)"
        },
        {
          "name": "deployment-operator",
          "description": "SYNTHETIC console staff role (granted through the /vsp/deployment-operator group)"
        },
        {
          "name": "security-admin",
          "description": "SYNTHETIC console staff role (granted through the /vsp/security-admin group)"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "vsp-console",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__VSP_SYNTH_CLIENT_SECRET__",
      "redirectUris": [
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "vsp-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "vsp-console",
            "claim.name": "vsp_roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
