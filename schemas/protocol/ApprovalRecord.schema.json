{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/ApprovalRecord.json",
  "title": "ApprovalRecord",
  "x-protocol-version": "2026-10-17.1",
  "x-contract-version": "approval-record.v1",
  "x-common-fields": {
    "schemaVersion": "schemaVersion",
    "causationId": "causationId",
    "occurredAt": "grantedAt",
    "expiresAt": "expiresAt",
    "provenance": "approver"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "approval-record.v1"
    },
    "causationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^apr_[A-Za-z0-9_-]{8,64}$"
    },
    "approver": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": [
            "privacy_counsel",
            "security_leadership",
            "clinical_safety_lead",
            "finance",
            "operations",
            "executive_sponsor",
            "identity_owner",
            "salesforce_admin",
            "talkdesk_admin",
            "sre_lead",
            "qa_language_lead"
          ]
        }
      },
      "required": [
        "name",
        "role"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "string",
      "enum": [
        "PHI_PROCESSING",
        "VENDOR_SANDBOX_INTEGRATION",
        "BILLABLE_TEST_EXECUTION",
        "PSTN_TEST_CALLS",
        "PRODUCTION_DEPLOYMENT",
        "PILOT_EXPOSURE",
        "MODEL_VOICE_SELECTION",
        "POLICY_RELEASE",
        "KNOWLEDGE_RELEASE",
        "CLINICAL_SCRIPTS",
        "RETENTION_SCHEDULE",
        "STATIC_CREDENTIAL_EXCEPTION",
        "SECURITY_REVIEW"
      ]
    },
    "scopeDetail": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "subject": {
      "type": "object",
      "properties": {
        "modelVoice": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
            },
            "voice": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
            },
            "agentConfig": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
            }
          },
          "required": [
            "model",
            "voice",
            "agentConfig"
          ],
          "additionalProperties": false
        },
        "policyBundle": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "version",
            "digest"
          ],
          "additionalProperties": false
        },
        "knowledgeSnapshotDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "templateCatalogDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "release": {
          "type": "object",
          "properties": {
            "imageDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "imageDigest"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "ci",
        "sandbox",
        "staging",
        "production"
      ]
    },
    "grantedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "evidenceRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512
    },
    "signature": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "approvalId",
    "approver",
    "scope",
    "scopeDetail",
    "environment",
    "grantedAt",
    "expiresAt",
    "evidenceRef",
    "signature"
  ],
  "additionalProperties": false
}
