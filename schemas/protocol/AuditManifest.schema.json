{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/AuditManifest.json",
  "title": "AuditManifest",
  "x-protocol-version": "2026-10-17.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifestId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "sourceStream": {
      "type": "string"
    },
    "firstSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "lastSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "eventCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "firstPrevHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "batchDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "objectKey": {
      "type": "string",
      "maxLength": 256
    }
  },
  "required": [
    "manifestId",
    "sourceStream",
    "firstSequence",
    "lastSequence",
    "eventCount",
    "firstPrevHash",
    "lastHash",
    "batchDigest",
    "createdAt",
    "objectKey"
  ],
  "additionalProperties": false
}
