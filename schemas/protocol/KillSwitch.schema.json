{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/KillSwitch.json",
  "title": "KillSwitch",
  "x-protocol-version": "2026-10-17.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "switchId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "AI_ADMISSION",
        "INTENT",
        "INTEGRATION",
        "WRITES",
        "MODEL_VERSION",
        "VOICE_VERSION",
        "OUTBOUND_NOTIFICATIONS"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "engaged": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "maxLength": 300
    },
    "changedBy": {
      "type": "string",
      "maxLength": 80
    },
    "changedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "switchId",
    "scope",
    "target",
    "engaged",
    "reason",
    "changedBy",
    "changedAt"
  ],
  "additionalProperties": false
}
