{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/PreparedAction.json",
  "title": "PreparedAction",
  "x-protocol-version": "2026-10-17.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "actionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "appointment.reschedule",
        "appointment.create",
        "appointment.cancel",
        "billing.review.submit",
        "support_request.create",
        "callback.schedule"
      ]
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "sessionRef": {
      "type": "string",
      "pattern": "^ses_[A-Za-z0-9_-]{16,64}$"
    },
    "sessionGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "actorId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "subjectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "target": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "enum": [
            "scheduling",
            "billing",
            "claims",
            "provider",
            "support_records",
            "internal"
          ]
        },
        "recordType": {
          "type": "string",
          "pattern": "^[a-z_]{3,40}$"
        },
        "recordRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
        },
        "beforeVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "system",
        "recordType",
        "recordRef",
        "beforeVersion"
      ],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,40}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 120
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "impact": {
      "type": "object",
      "properties": {
        "summaryTemplateId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{2,80}$"
        },
        "fees": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "currency": {
                  "type": "string",
                  "const": "USD"
                },
                "minorUnits": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "currency",
                "minorUnits"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "reversible": {
          "type": "boolean"
        }
      },
      "required": [
        "summaryTemplateId",
        "fees",
        "reversible"
      ],
      "additionalProperties": false
    },
    "policyDecisionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "preparedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "confirmationTemplateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{2,80}$"
    },
    "requiresStepUp": {
      "type": "boolean"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "PREPARED",
        "CONFIRMED",
        "COMMITTING",
        "COMMITTED",
        "FAILED",
        "UNKNOWN",
        "INVALIDATED",
        "EXPIRED",
        "CANCELLED"
      ]
    }
  },
  "required": [
    "actionId",
    "kind",
    "tenantId",
    "sessionRef",
    "sessionGeneration",
    "actorId",
    "subjectId",
    "target",
    "change",
    "impact",
    "policyDecisionId",
    "policyVersion",
    "preparedAt",
    "expiresAt",
    "confirmationTemplateId",
    "requiresStepUp",
    "digest",
    "state"
  ],
  "additionalProperties": false
}
