{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/SpeechDirective.json",
  "title": "SpeechDirective",
  "x-protocol-version": "2026-10-17.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "templateId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{2,80}$"
    },
    "templateVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "responseClass": {
      "type": "string",
      "enum": [
        "IDENTITY",
        "FINANCIAL_FACT",
        "COMMITMENT",
        "CLINICAL_BOUNDARY",
        "RECORDING_DISCLOSURE",
        "SAFETY",
        "PROTECTED_FACT",
        "LOW_RISK_GROUNDED",
        "GENERIC_STATUS"
      ]
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9]{0,40}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 200
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "authorizationRef": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceRefs": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "turnId": {
      "type": "string",
      "pattern": "^turn_[A-Za-z0-9_-]{4,64}$"
    },
    "sessionGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "templateId",
    "templateVersion",
    "responseClass",
    "slots",
    "authorizationRef",
    "sourceRefs",
    "turnId",
    "sessionGeneration"
  ],
  "additionalProperties": false
}
