{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/Budget.json",
  "title": "Budget",
  "x-protocol-version": "2026-10-17.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "budgetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string"
        },
        "cohort": {
          "type": "string",
          "maxLength": 64
        },
        "workflow": {
          "type": "string",
          "maxLength": 64
        },
        "vendor": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "environment",
        "cohort",
        "workflow",
        "vendor"
      ],
      "additionalProperties": false
    },
    "periodStart": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "periodEnd": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "limitUsd": {
      "type": "number",
      "minimum": 0
    },
    "safetyReserveUsd": {
      "type": "number",
      "minimum": 0
    },
    "spentUsd": {
      "type": "number",
      "minimum": 0
    },
    "meteringDelayMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "approvedBy": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    }
  },
  "required": [
    "budgetId",
    "scope",
    "periodStart",
    "periodEnd",
    "limitUsd",
    "safetyReserveUsd",
    "spentUsd",
    "meteringDelayMinutes",
    "approvedBy",
    "version"
  ],
  "additionalProperties": false
}
