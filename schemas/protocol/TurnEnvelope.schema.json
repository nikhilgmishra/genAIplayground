{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/TurnEnvelope.json",
  "title": "TurnEnvelope",
  "x-protocol-version": "2026-10-17.1",
  "x-contract-version": "turn-envelope.v1",
  "x-common-fields": {
    "schemaVersion": "schemaVersion",
    "tenantId": "tenantId",
    "interactionId": "interactionId",
    "caseId": "caseId",
    "sessionGeneration": "sessionGeneration",
    "turnId": "turnId",
    "causationId": "causationId",
    "occurredAt": "occurredAt",
    "dataClassification": "dataClassification",
    "versions": "asr.engineRef",
    "provenance": "speaker"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "turn-envelope.v1"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "interactionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "sessionGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "turnId": {
      "type": "string",
      "pattern": "^turn_[A-Za-z0-9_-]{4,64}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "dataClassification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "PHI",
        "PHI_RESTRICTED",
        "FINANCIAL",
        "VERIFICATION_SECRET"
      ]
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "caseId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "turnRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "speaker": {
      "type": "string",
      "enum": [
        "caller",
        "agent_runtime",
        "human_agent",
        "system"
      ]
    },
    "inputKind": {
      "type": "string",
      "enum": [
        "SPEECH",
        "DTMF_ISOLATED",
        "BACKCHANNEL",
        "INTERRUPTION",
        "SILENCE",
        "NON_SPEECH_NOISE",
        "SYSTEM_EVENT"
      ]
    },
    "voiceMode": {
      "type": "string",
      "enum": [
        "CONTROLLED_CASCADE",
        "NATIVE_DUPLEX"
      ]
    },
    "timing": {
      "type": "object",
      "properties": {
        "speechStartedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "speechEndedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "endpointedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "firstMeaningfulAudioAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "speechStartedAt",
        "speechEndedAt",
        "endpointedAt",
        "firstMeaningfulAudioAt"
      ],
      "additionalProperties": false
    },
    "asr": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "engineRef": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
            },
            "confidence": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "final": {
              "type": "boolean"
            },
            "entityUncertain": {
              "type": "boolean"
            }
          },
          "required": [
            "engineRef",
            "language",
            "confidence",
            "final",
            "entityUncertain"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "interruption": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "interruptedTurnId": {
              "type": "string",
              "pattern": "^turn_[A-Za-z0-9_-]{4,64}$"
            },
            "detectedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "playbackStoppedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "interruptedTurnId",
            "detectedAt",
            "playbackStoppedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "transcriptRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._~:/#@+=-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dtmfCaptured": {
      "type": "boolean"
    },
    "speechPlanRefs": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
      }
    },
    "toolRequestRefs": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "tenantId",
    "interactionId",
    "sessionGeneration",
    "turnId",
    "occurredAt",
    "dataClassification",
    "causationId",
    "caseId",
    "turnRevision",
    "speaker",
    "inputKind",
    "voiceMode",
    "timing",
    "asr",
    "interruption",
    "transcriptRef",
    "dtmfCaptured",
    "speechPlanRefs",
    "toolRequestRefs"
  ],
  "additionalProperties": false
}
