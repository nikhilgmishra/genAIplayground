{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/IssueOutcomeRecord.json",
  "title": "IssueOutcomeRecord",
  "x-protocol-version": "2026-10-17.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "RESOLVED_WITH_EVIDENCE",
        "INFORMATION_PROVIDED",
        "REQUEST_ACCEPTED",
        "WAITING_FOR_SYSTEM",
        "WAITING_FOR_HUMAN",
        "WAITING_FOR_CALLER",
        "TRANSFERRED_WITH_ACCEPTANCE",
        "DECLINED_BY_POLICY",
        "CALLER_DISCONNECTED",
        "FAILED",
        "OUTCOME_UNKNOWN"
      ]
    },
    "reopened": {
      "type": "boolean"
    },
    "partiallyResolved": {
      "type": "boolean"
    },
    "evidenceRefs": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9._~:/#@+=-]+$"
      }
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "outcome",
    "reopened",
    "partiallyResolved",
    "evidenceRefs",
    "recordedAt"
  ],
  "additionalProperties": false
}
