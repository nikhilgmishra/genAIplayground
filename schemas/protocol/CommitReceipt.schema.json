{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/CommitReceipt.json",
  "title": "CommitReceipt",
  "x-protocol-version": "2026-10-17.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "receiptId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "actionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "outcome": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "COMMITTED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "providerSystem": {
      "type": "string",
      "enum": [
        "scheduling",
        "billing",
        "claims",
        "provider",
        "support_records",
        "internal"
      ]
    },
    "providerReference": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "providerIdempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "afterVersion": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "committedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "evidenceHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "auditEventId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "reconciled": {
      "type": "boolean"
    }
  },
  "required": [
    "receiptId",
    "actionId",
    "idempotencyKey",
    "outcome",
    "providerSystem",
    "providerReference",
    "providerIdempotencyKey",
    "afterVersion",
    "committedAt",
    "recordedAt",
    "evidenceHash",
    "auditEventId",
    "reconciled"
  ],
  "additionalProperties": false
}
