              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
            },
            "toolCatalog": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "knowledgeSnapshot": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
            },
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
            }
          },
          "required": [
            "agentConfig",
            "model",
            "voice",
            "promptTemplates",
            "policyBundle",
            "toolCatalog",
            "knowledgeSnapshot",
            "schema"
