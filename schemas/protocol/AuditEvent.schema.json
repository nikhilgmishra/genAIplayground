  "required": [
    "eventId",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "parentId",
    "tenantId",
    "actorRef",
    "subjectRef",
    "role",
    "sourceComponent",
    "callId",
    "sessionRef",
    "sessionGeneration",
    "turnId",
    "versions",
    "action",
    "policyDecision",
    "assurance",
    "evidencePointers",
    "beforeHash",
    "afterHash",
    "idempotencyKey",
    "outcome",
    "reasonCode",
    "dataClass",
    "sourceStream",
    "sequence",
    "prevHash",
    "hash"
  ],
  "additionalProperties": false
}
