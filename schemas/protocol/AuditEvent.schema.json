            {
              "type": "string",
              "enum": [
                "support_agent",
                "supervisor",
                "safety_responder",
                "auditor",
                "knowledge_editor",
                "policy_approver",
                "deployment_operator",
                "security_admin"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceComponent": {
      "type": "string",
      "enum": [
        "gateway",
        "mcp_adapter",
        "telephony_control",
        "identity",
        "policy",
        "actions",
        "workflow",
        "knowledge",
        "safety",
        "voice_gate",
        "console",
        "worker",
        "retention",
        "config"
      ]
