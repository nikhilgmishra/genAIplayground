{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/AuditEvent.json",
  "title": "AuditEvent",
  "x-protocol-version": "2026-10-17.1",
  "x-contract-version": "audit.v1",
  "x-common-fields": {
    "schemaVersion": "schemaVersion",
    "tenantId": "tenantId",
    "interactionId": "callId",
    "actorRef": "actorRef",
    "subjectRef": "subjectRef",
    "sessionGeneration": "sessionGeneration",
    "turnId": "turnId",
    "causationId": "causationId",
    "occurredAt": "occurredAt",
    "dataClassification": "dataClass",
    "versions": "versions",
    "provenance": "sourceComponent",
    "outcome": "outcome"
