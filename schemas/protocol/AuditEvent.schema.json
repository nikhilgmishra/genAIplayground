      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "configDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receiptRefs": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schemaId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "schemaVersion": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "authMechanism": {
          "type": "string",
          "enum": [
            "HMAC_SHA256_HEADER",
            "HMAC_SHA1_HEADER",
            "JWT_BEARER",
            "MTLS",
            "RECONCILE_BY_LOOKUP",
            "STREAM_IAM"
          ]
