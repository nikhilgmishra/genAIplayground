    "sourceStream": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]{3,64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "prevHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
