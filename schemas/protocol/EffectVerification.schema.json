{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/EffectVerification.json",
  "title": "EffectVerification",
  "x-protocol-version": "2026-10-17.1",
  "x-contract-version": "effect-verification.v1",
  "x-common-fields": {
    "schemaVersion": "schemaVersion",
    "tenantId": "tenantId",
    "interactionId": "interactionId",
    "caseId": "caseId",
    "workflowId": "workflowId",
    "causationId": "causationId",
    "occurredAt": "occurredAt",
    "versions": "expected.version",
    "provenance": "method",
    "outcome": "result"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "effect-verification.v1"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "causationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "caseId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflowId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "interactionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "verificationId": {
      "type": "string",
      "pattern": "^efv_[A-Za-z0-9_-]{16,64}$"
    },
    "actionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "commitReceiptId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "type": "string",
      "enum": [
        "AUTHORITATIVE_READ_BACK",
        "TRUSTED_COMPLETION_EVENT",
        "EXTERNAL_KEY_LOOKUP",
        "HUMAN_ATTESTATION"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "enum": [
            "scheduling",
            "billing",
            "claims",
            "provider",
            "support_records",
            "internal"
          ]
        },
        "recordType": {
          "type": "string",
          "pattern": "^[a-z_]{3,40}$"
        },
        "recordRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
        }
      },
      "required": [
        "system",
        "recordType",
        "recordRef"
      ],
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "properties": {
        "stateDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stateDigest",
        "version"
      ],
      "additionalProperties": false
    },
    "observed": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "stateDigest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "observedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "sourceEventRef": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "stateDigest",
            "version",
            "observedAt",
            "sourceEventRef"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "MISMATCH",
        "PENDING_VISIBILITY",
        "NOT_FOUND_WITHIN_WINDOW",
        "NOT_FOUND_AFTER_WINDOW",
        "UNVERIFIABLE"
      ]
    },
    "visibilityWindowEndsAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._~:/#@+=-]+$"
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verifier": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
        },
        "connectorProfileRef": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "independentOfModel": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "component",
        "connectorProfileRef",
        "independentOfModel"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "tenantId",
    "causationId",
    "occurredAt",
    "caseId",
    "workflowId",
    "interactionId",
    "verificationId",
    "actionId",
    "commitReceiptId",
    "method",
    "target",
    "expected",
    "observed",
    "result",
    "visibilityWindowEndsAt",
    "evidenceRef",
    "evidenceDigest",
    "verifier"
  ],
  "additionalProperties": false
}
