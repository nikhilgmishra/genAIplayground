{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/SourceWatermark.json",
  "title": "SourceWatermark",
  "x-protocol-version": "2026-10-17.1",
  "x-contract-version": "source-watermark.v1",
  "x-common-fields": {
    "schemaVersion": "schemaVersion",
    "tenantId": "tenantId",
    "causationId": "causationId",
    "occurredAt": "occurredAt",
    "provenance": "source"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "source-watermark.v1"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "watermarkId": {
      "type": "string",
      "pattern": "^wmk_[A-Za-z0-9_-]{16,64}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,40}$"
        },
        "stream": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
        },
        "connectorProfileRef": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "system",
        "stream",
        "connectorProfileRef"
      ],
      "additionalProperties": false
    },
    "low": {
      "type": "object",
      "properties": {
        "offset": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:/=+-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventTime": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "offset",
        "eventTime"
      ],
      "additionalProperties": false
    },
    "high": {
      "type": "object",
      "properties": {
        "offset": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:/=+-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "eventTime": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "offset",
        "eventTime"
      ],
      "additionalProperties": false
    },
    "lastEventReceivedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastHeartbeatAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expectedCount": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "deliveredCount": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "gapState": {
      "type": "string",
      "enum": [
        "NO_GAP_DETECTED",
        "GAP_DETECTED",
        "RECONCILING",
        "SOURCE_SILENT_UNVERIFIED"
      ]
    },
    "snapshotBoundary": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "snapshotRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:/-]+$"
            },
            "deltaFromOffset": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "snapshotRef",
            "deltaFromOffset"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "reconciledAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "maxAgeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2678400000
    }
  },
  "required": [
    "schemaVersion",
    "tenantId",
    "occurredAt",
    "causationId",
    "watermarkId",
    "source",
    "low",
    "high",
    "lastEventReceivedAt",
    "lastHeartbeatAt",
    "expectedCount",
    "deliveredCount",
    "gapState",
    "snapshotBoundary",
    "reconciledAt",
    "maxAgeMs"
  ],
  "additionalProperties": false
}
