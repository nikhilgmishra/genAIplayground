{
  "$id": "https://schemas.voice-support.invalid/protocol/2026-10-17.1/ActivationReport.json",
  "title": "ActivationReport",
  "x-protocol-version": "2026-10-17.1",
  "x-contract-version": "activation-report.v1",
  "x-common-fields": {
    "schemaVersion": "schemaVersion",
    "tenantId": "tenantId",
    "causationId": "causationId",
    "occurredAt": "occurredAt",
    "versions": "tenantConfigDigest",
    "provenance": "generatedBy"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "activation-report.v1"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reportId": {
      "type": "string",
      "pattern": "^acp_[A-Za-z0-9_-]{16,64}$"
    },
    "targetEnvironment": {
      "type": "string",
      "enum": [
        "local",
        "ci",
        "sandbox",
        "staging",
        "production"
      ]
    },
    "tenantConfigDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "generatedBy": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
    },
    "records": {
      "minItems": 1,
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "activation-record.v1"
          },
          "tenantId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "causationId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{16,64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "expiresAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "recordId": {
            "type": "string",
            "pattern": "^acr_[A-Za-z0-9_-]{16,64}$"
          },
          "capabilityId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$"
          },
          "workflowRef": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "software": {
            "type": "string",
            "enum": [
              "MISSING",
              "IMPLEMENTED",
              "VERIFIED_LOCAL",
              "RELEASE_PACKAGE_VERIFIED"
            ]
          },
          "environment": {
            "type": "string",
            "enum": [
              "NOT_CONFIGURED",
              "CONFIGURED",
              "VERIFIED_SANDBOX",
              "APPROVED_PILOT",
              "VERIFIED_PRODUCTION"
            ]
          },
          "qualification": {
            "type": "string",
            "enum": [
              "NOT_RUN",
              "FAIL",
              "INCONCLUSIVE",
              "PASS"
            ]
          },
          "evidenceRefs": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9._~:/#@+=-]+$"
            }
          },
          "missingInputs": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AIN-[0-9]{2,3}$"
            }
          },
          "approvalsRequired": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PHI_PROCESSING",
                "VENDOR_SANDBOX_INTEGRATION",
                "BILLABLE_TEST_EXECUTION",
                "PSTN_TEST_CALLS",
                "PRODUCTION_DEPLOYMENT",
                "PILOT_EXPOSURE",
                "MODEL_VOICE_SELECTION",
                "POLICY_RELEASE",
                "KNOWLEDGE_RELEASE",
                "CLINICAL_SCRIPTS",
                "RETENTION_SCHEDULE",
                "STATIC_CREDENTIAL_EXCEPTION",
                "SECURITY_REVIEW"
              ]
            }
          },
          "approvalsPresent": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "string",
                  "enum": [
                    "PHI_PROCESSING",
                    "VENDOR_SANDBOX_INTEGRATION",
                    "BILLABLE_TEST_EXECUTION",
                    "PSTN_TEST_CALLS",
                    "PRODUCTION_DEPLOYMENT",
                    "PILOT_EXPOSURE",
                    "MODEL_VOICE_SELECTION",
                    "POLICY_RELEASE",
                    "KNOWLEDGE_RELEASE",
                    "CLINICAL_SCRIPTS",
                    "RETENTION_SCHEDULE",
                    "STATIC_CREDENTIAL_EXCEPTION",
                    "SECURITY_REVIEW"
                  ]
                },
                "approvalId": {
                  "type": "string",
                  "pattern": "^apr_[A-Za-z0-9_-]{8,64}$"
                }
              },
              "required": [
                "scope",
                "approvalId"
              ],
              "additionalProperties": false
            }
          },
          "state": {
            "type": "string",
            "enum": [
              "NOT_ELIGIBLE",
              "ELIGIBLE",
              "ACTIVE",
              "SUSPENDED",
              "DEACTIVATED"
            ]
          },
          "reasonCodes": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            }
          }
        },
        "required": [
          "schemaVersion",
          "tenantId",
          "occurredAt",
          "causationId",
          "expiresAt",
          "recordId",
          "capabilityId",
          "workflowRef",
          "software",
          "environment",
          "qualification",
          "evidenceRefs",
          "missingInputs",
          "approvalsRequired",
          "approvalsPresent",
          "state",
          "reasonCodes"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "active": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "eligible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "notEligible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "suspended": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        },
        "deactivated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 512
        }
      },
      "required": [
        "active",
        "eligible",
        "notEligible",
        "suspended",
        "deactivated"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "tenantId",
    "occurredAt",
    "causationId",
    "reportId",
    "targetEnvironment",
    "tenantConfigDigest",
    "generatedBy",
    "records",
    "summary"
  ],
  "additionalProperties": false
}
