      "Comment": "Check the durable action grant for claim.findings.disclose, then recheck consent, representation, account state and current policy before this disclosure.",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${recheck_queue_url}",
        "MessageBody": {
          "workflowId.$": "$.workflowId",
          "tenantId.$": "$.tenantId",
          "workflowType": "claim_investigation",
          "definitionVersion": "1.0.0",
          "state": "WAITING_FOR_HUMAN",
          "event": "HUMAN_APPROVED",
          "toState": "COMPLETED",
          "guard": "disclosure",
          "grantAction": "claim.findings.disclose",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "TimeoutSeconds": 300,
      "ResultSelector": {
        "decision.$": "$.decision"
      },
      "ResultPath": "$.recheck",
      "Retry": [
        {
          "ErrorEquals": [
            "Workflow.Retryable"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "MaxDelaySeconds": 60,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "WAITING_FOR_HUMAN__FailureEscalation"
        }
      ],
      "Next": "WAITING_FOR_HUMAN__Recheck_HUMAN_APPROVED__Decision"
    },
    "WAITING_FOR_HUMAN__Recheck_HUMAN_APPROVED__Decision": {
      "Type": "Choice",
      "Comment": "Only an explicit ALLOW proceeds; anything else records POLICY_CHANGED_PENDING_ACTION.",
      "Choices": [
        {
          "Not": {
            "Variable": "$.recheck.decision",
            "IsPresent": true
          },
          "Next": "WAITING_FOR_HUMAN"
        },
        {
          "Variable": "$.recheck.decision",
          "StringEquals": "ALLOW",
          "Next": "COMPLETED"
        }
      ],
      "Default": "WAITING_FOR_HUMAN"
    },
    "WAITING_FOR_CALLER": {
      "Type": "Task",
      "Comment": "owner q_claims_specialists; deadline P14D; retry budget 2; escalation ESCALATED -> q_claims_supervisors",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${notify_queue_url}",
        "MessageBody": {
          "workflowId.$": "$.workflowId",
          "tenantId.$": "$.tenantId",
          "workflowType": "claim_investigation",
          "definitionVersion": "1.0.0",
          "state": "WAITING_FOR_CALLER",
          "ownerQueue": "q_claims_specialists",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "TimeoutSeconds": 1209600,
      "HeartbeatSeconds": 3600,
      "ResultSelector": {
        "event.$": "$.event",
        "actorKind.$": "$.actorKind"
      },
      "ResultPath": "$.signal",
      "Retry": [
        {
          "ErrorEquals": [
            "Workflow.Retryable"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2,
          "MaxDelaySeconds": 3600,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout",
            "States.HeartbeatTimeout"
          ],
          "ResultPath": null,
          "Next": "WAITING_FOR_CALLER__DeadlineEscalation"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "WAITING_FOR_CALLER__FailureEscalation"
        }
      ],
      "Next": "WAITING_FOR_CALLER__Route"
    },
    "WAITING_FOR_CALLER__Route": {
      "Type": "Choice",
      "Comment": "Route the worker-reported event from a permitted actor kind; anything else escalates.",
      "Choices": [
        {
          "Not": {
            "Variable": "$.signal.event",
            "IsPresent": true
          },
          "Next": "WAITING_FOR_CALLER__InvalidSignalEscalation"
        },
        {
          "Not": {
            "Variable": "$.signal.actorKind",
            "IsPresent": true
          },
          "Next": "WAITING_FOR_CALLER__InvalidSignalEscalation"
        },
        {
          "And": [
            {
              "Variable": "$.signal.event",
              "StringEquals": "CALLER_RESPONDED"
            },
            {
              "Or": [
                {
                  "Variable": "$.signal.actorKind",
                  "StringEquals": "caller"
                },
                {
                  "Variable": "$.signal.actorKind",
                  "StringEquals": "staff"
                },
                {
                  "Variable": "$.signal.actorKind",
                  "StringEquals": "system"
                }
              ]
            }
          ],
          "Next": "VALIDATING"
        },
        {
          "And": [
            {
              "Variable": "$.signal.event",
              "StringEquals": "CANCEL"
            },
            {
              "Or": [
                {
                  "Variable": "$.signal.actorKind",
                  "StringEquals": "staff"
                },
                {
                  "Variable": "$.signal.actorKind",
                  "StringEquals": "system"
                }
              ]
            }
          ],
          "Next": "CANCELLED"
        },
        {
          "And": [
            {
              "Variable": "$.signal.event",
              "StringEquals": "ESCALATED"
            },
            {
              "Or": [
                {
                  "Variable": "$.signal.actorKind",
                  "StringEquals": "staff"
                },
                {
                  "Variable": "$.signal.actorKind",
                  "StringEquals": "system"
                }
              ]
            }
          ],
          "Next": "WAITING_FOR_HUMAN"
        }
      ],
      "Default": "WAITING_FOR_CALLER__InvalidSignalEscalation"
    },
    "WAITING_FOR_CALLER__DeadlineEscalation": {
      "Type": "Pass",
      "Result": {
        "event": "ESCALATED",
        "actorKind": "system",
        "cause": "DEADLINE_EXCEEDED"
      },
      "ResultPath": "$.signal",
      "Next": "WAITING_FOR_CALLER__NotifyEscalation"
    },
    "WAITING_FOR_CALLER__FailureEscalation": {
      "Type": "Pass",
      "Result": {
        "event": "ESCALATED",
        "actorKind": "system",
        "cause": "RETRY_BUDGET_EXHAUSTED"
      },
      "ResultPath": "$.signal",
      "Next": "WAITING_FOR_CALLER__NotifyEscalation"
    },
    "WAITING_FOR_CALLER__InvalidSignalEscalation": {
      "Type": "Pass",
      "Result": {
        "event": "ESCALATED",
        "actorKind": "system",
        "cause": "INVALID_SIGNAL"
      },
      "ResultPath": "$.signal",
      "Next": "WAITING_FOR_CALLER__NotifyEscalation"
    },
    "WAITING_FOR_CALLER__NotifyEscalation": {
      "Type": "Task",
      "Comment": "Notify escalation owner q_claims_supervisors; escalation proceeds even if the notice cannot be sent.",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "${escalation_queue_url}",
        "MessageBody": {
          "workflowId.$": "$.workflowId",
          "tenantId.$": "$.tenantId",
          "workflowType": "claim_investigation",
          "definitionVersion": "1.0.0",
          "state": "WAITING_FOR_CALLER",
          "escalationOwnerQueue": "q_claims_supervisors",
          "cause.$": "$.signal.cause"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "MaxDelaySeconds": 60,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "WAITING_FOR_CALLER__Route"
        }
      ],
      "Next": "WAITING_FOR_CALLER__Route"
    },
    "COMPLETED": {
      "Type": "Succeed",
      "Comment": "Workflow completed. Completion is not resolution without commit receipts (ACT-04)."
    },
    "FAILED": {
      "Type": "Fail",
      "Comment": "Workflow failed; the ledger records the reason code.",
      "Error": "Workflow.Failed",
      "Cause": "WORKFLOW_FAILED"
    },
    "CANCELLED": {
      "Type": "Succeed",
      "Comment": "Workflow cancelled before any uncommitted work was applied."
    }
  }
}
