# Durable follow-up workflows (spec sections 3 and 9) as Step Functions STANDARD
# state machines. Definitions are generated by platform/src/workflows/generate-asl.ts
# into infra/stepfunctions/*.asl.json (owned by the workflows module) and rendered
# here with templatefile() so resource ARNs are substituted, never hand-edited.
# Logging never includes execution data (inputs/outputs could carry references the
# spec keeps out of general logs); state machines are encrypted with a CMK.

variable "name_prefix" {
  description = "Opaque resource name prefix (no PHI)."
  type        = string
  nullable    = false

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{2,24}$", var.name_prefix))
    error_message = "name_prefix must be 3-25 chars of lowercase letters, digits and hyphens."
  }
}

variable "account_id" {
  description = "Workload AWS account id."
  type        = string
  nullable    = false

  validation {
    condition     = can(regex("^[0-9]{12}$", var.account_id))
    error_message = "account_id must be a 12-digit AWS account id."
  }
}

variable "region" {
  description = "AWS region (US only)."
  type        = string
  nullable    = false

  validation {
    condition     = can(regex("^us-[a-z]+-[0-9]$", var.region))
    error_message = "region must be a US commercial region."
  }
}

variable "partition" {
  description = "AWS partition."
  type        = string
  default     = "aws"
}

variable "definitions_dir" {
  description = "Directory containing generated *.asl.json files. Missing or empty = no state machines (validation still passes)."
  type        = string
  nullable    = false
}

variable "definition_substitutions" {
  description = "templatefile() variables available to every definition (e.g. queue URLs). A definition referencing an unknown placeholder fails the plan (fail closed)."
  type        = map(string)
  default     = {}
}

variable "log_level" {
  description = "Execution logging level. OFF is not allowed; include_execution_data is always false."
  type        = string
  default     = "ERROR"

  validation {
    condition     = contains(["ERROR", "ALL", "FATAL"], var.log_level)
    error_message = "log_level must be ERROR, ALL or FATAL (OFF is not allowed)."
  }
}

variable "xray_tracing_enabled" {
  description = "X-Ray tracing (trace segments carry no execution data, but enabling it is a reviewed choice)."
  type        = bool
  default     = false
}

variable "kms_key_arn" {
  description = "CMK encrypting state machine definitions and execution data."
  type        = string
  nullable    = false
}

variable "logs_kms_key_arn" {
  description = "CMK for the execution log group."
  type        = string
  nullable    = false
}

variable "log_retention_days" {
  description = "Execution log retention. No default: set in the retention matrix."
  type        = number
  nullable    = false

  validation {
    condition     = contains([1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1096, 1827, 2192, 2557, 2922, 3288, 3653], var.log_retention_days)
    error_message = "log_retention_days must be a CloudWatch Logs retention value."
  }
}

variable "send_queue_arns" {
  description = "Queues the workflows may send to (worker callbacks, human-task notifications)."
  type        = list(string)
  default     = []
}

variable "queue_kms_key_arn" {
  description = "CMK of the queues in send_queue_arns."
  type        = string
  default     = null
}

variable "permissions_boundary_arn" {
  description = "Permissions boundary for the execution role."
  type        = string
  default     = null
}

variable "tags" {
  description = "Tags applied to every resource (no PHI)."
  type        = map(string)
  default     = {}
}

locals {
  files = fileset(var.definitions_dir, "*.asl.json")

  machines = {
    for f in local.files : replace(trimsuffix(f, ".asl.json"), "_", "-") => "${var.definitions_dir}/${f}"
  }

  base_substitutions = {
    aws_region  = var.region
    account_id  = var.account_id
    partition   = var.partition
    name_prefix = var.name_prefix
  }

  machine_arn_prefix = "arn:${var.partition}:states:${var.region}:${var.account_id}:stateMachine:${var.name_prefix}-"
  log_group_name     = "/aws/vendedlogs/states/${var.name_prefix}-workflows"
}

resource "aws_cloudwatch_log_group" "executions" {
  name                        = local.log_group_name
  retention_in_days           = var.log_retention_days
  kms_key_id                  = var.logs_kms_key_arn
  deletion_protection_enabled = true

  tags = merge(var.tags, { "vsp:data-class" = "OPERATIONAL_TELEMETRY" })
}

resource "aws_iam_role" "workflows" {
  name                 = "${var.name_prefix}-workflows"
  permissions_boundary = var.permissions_boundary_arn
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "states.amazonaws.com" }
      Action    = "sts:AssumeRole"
      Condition = {
        StringEquals = { "aws:SourceAccount" = var.account_id }
        ArnLike      = { "aws:SourceArn" = "${local.machine_arn_prefix}*" }
      }
    }]
  })

  tags = var.tags
}

resource "aws_iam_role_policy" "workflows" {
  name = "workflows-least-privilege"
  role = aws_iam_role.workflows.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = concat(
      [
        {
          # CloudWatch Logs vended-log delivery APIs do not support resource-level permissions.
          Sid    = "VendedLogDelivery"
          Effect = "Allow"
          Action = [
            "logs:CreateLogDelivery", "logs:GetLogDelivery", "logs:UpdateLogDelivery",
            "logs:DeleteLogDelivery", "logs:ListLogDeliveries", "logs:PutResourcePolicy",
            "logs:DescribeResourcePolicies", "logs:DescribeLogGroups",
          ]
          Resource = "*"
        },
        {
          Sid       = "StateMachineEncryption"
          Effect    = "Allow"
          Action    = ["kms:Decrypt", "kms:GenerateDataKey"]
          Resource  = [var.kms_key_arn]
          Condition = { ArnLike = { "kms:EncryptionContext:aws:states:stateMachineArn" = "${local.machine_arn_prefix}*" } }
        },
      ],
      [for st in [
        {
          Sid      = "SendToWorkflowQueues"
          Effect   = "Allow"
          Action   = ["sqs:SendMessage"]
          Resource = var.send_queue_arns
        },
        {
          Sid       = "EncryptQueueMessages"
          Effect    = "Allow"
          Action    = ["kms:GenerateDataKey", "kms:Decrypt"]
          Resource  = [coalesce(var.queue_kms_key_arn, var.kms_key_arn)]
          Condition = { StringEquals = { "kms:ViaService" = "sqs.${var.region}.amazonaws.com" } }
        },
      ] : st if length(var.send_queue_arns) > 0],
      [for st in [
        {
          Sid      = "XRayTraces"
          Effect   = "Allow"
          Action   = ["xray:PutTraceSegments", "xray:PutTelemetryRecords", "xray:GetSamplingRules", "xray:GetSamplingTargets"]
          Resource = "*"
        },
      ] : st if var.xray_tracing_enabled],
    )
  })
}

resource "aws_sfn_state_machine" "this" {
  for_each = local.machines

  name       = "${var.name_prefix}-${each.key}"
  type       = "STANDARD"
  role_arn   = aws_iam_role.workflows.arn
  definition = templatefile(each.value, merge(var.definition_substitutions, local.base_substitutions))
  publish    = true

  logging_configuration {
    log_destination        = "${aws_cloudwatch_log_group.executions.arn}:*"
    include_execution_data = false
    level                  = var.log_level
  }

  tracing_configuration {
    enabled = var.xray_tracing_enabled
  }

  encryption_configuration {
    type                              = "CUSTOMER_MANAGED_KMS_KEY"
    kms_key_id                        = var.kms_key_arn
    kms_data_key_reuse_period_seconds = 300
  }

  tags = merge(var.tags, { "vsp:workflow" = each.key })
}

# New executions start through the "live" alias, which points at the version
# published with the current definition; running executions keep their version.
resource "aws_sfn_alias" "live" {
  for_each = aws_sfn_state_machine.this

  name        = "live"
  description = "Current published definition version"

  routing_configuration {
    state_machine_version_arn = each.value.state_machine_version_arn
    weight                    = 100
  }
}

output "state_machine_alias_arns" {
  description = "Alias ARNs used to start executions, keyed by workflow name."
  value       = { for k, a in aws_sfn_alias.live : k => a.arn }
}

output "state_machine_arns" {
  description = "State machine ARNs keyed by workflow name (from the ASL file name)."
  value       = { for k, m in aws_sfn_state_machine.this : k => m.arn }
}

output "state_machine_arn_prefix" {
  description = "ARN prefix covering every state machine of this stack (for IAM)."
  value       = local.machine_arn_prefix
}

output "definition_files" {
  description = "ASL files discovered."
  value       = sort(tolist(local.files))
}

output "execution_role_arn" {
  description = "State machine execution role."
  value       = aws_iam_role.workflows.arn
}
